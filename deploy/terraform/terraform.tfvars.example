# ── Proxmox ──────────────────────────────────────────────
proxmox_api_url          = "https://your-proxmox-ip:8006/api2/json"
proxmox_api_token_id     = "terraform@pam!terraform-token"
proxmox_api_token_secret = "your-api-token-secret"
proxmox_node             = "pve"

# ── Container ────────────────────────────────────────────
kronize_ct_id    = 109
ct_root_password = "change-me"
storage_pool     = "local-lvm"
cpu_cores        = 1
disk_size        = 5G

# ── Docker registry ──────────────────────────────────────
registry_url     = "your-registry-url"
registry_username = "your-registry-user"
registry_password = "your-registry-password"

# ── App ──────────────────────────────────────────────────
domain     = "kronize.yourdomain.com"
app_port   = 8080
jwt_secret = "change-me-to-a-random-string"
tls_cert_file = "/etc/traefik/certs/kronize.yourdomain.com.crt"
tls_key_file  = "/etc/traefik/certs/kronize.yourdomain.com.key"

# ── Traefik ──────────────────────────────────────────────
traefik_ct_id        = 103
proxmox_host         = "10.0.0.1"
proxmox_ssh_user     = "root"
proxmox_ssh_password = "change-me"
