[Unit]
Description=Kronize Cron Management System
After=network.target docker.service
Requires=docker.service
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kronize \
  -db /opt/kronize/data/kronize.db \
  -scripts /opt/kronize/scripts \
  -addr :${app_port} \
  -jwt-secret ${jwt_secret}
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
